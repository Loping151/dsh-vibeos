{
  "name": "dsh-vibeos",
  "description": "VibeOS for DeepSeek Harness: a model-driven virtual desktop that takes over the DSH web UI — AI-generated app windows, taskbar, spotlight, skins — with classic chat one toggle away. Port of benis-me/VibeOS.",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tsconfig.json",
    "tsdown.config.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "tsconfig.host.json",
    "tsconfig.client.json"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "vibeos",
    "generative-ui",
    "desktop"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.0",
    "react": "^18.3.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "react": "^18.0.0 || ^19.0.0",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.7 || ^0.2.0-rc.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.12",
    "jsdom": "^25.0.0",
    "lightningcss": "^1.25.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/cordis-plugin-timer": "~1.1.6",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/cordis-plugin-include": "~1.0.9"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && node scripts/build-css.mjs && tsdown",
    "test": "vitest run",
    "check": "rm -rf lib && tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && vitest run && node scripts/build-css.mjs && tsdown",
    "prepack": "node scripts/prepack.mjs",
    "verify-pack": "node scripts/verify-pack.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit --emitDeclarationOnly false && tsc -p tsconfig.client.json --noEmit --emitDeclarationOnly false",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loping151/dsh-vibeos.git"
  },
  "homepage": "https://github.com/Loping151/dsh-vibeos",
  "bugs": {
    "url": "https://github.com/Loping151/dsh-vibeos/issues"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-timeout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-timer": {
      "optional": true
    }
  }
}
